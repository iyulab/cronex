<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Cronex.Net.Hosting</PackageId>
    <Description>Generic Host integration for Cronex scheduler.</Description>
    <PackageTags>cron;scheduler;hosting;backgroundservice</PackageTags>
    <RootNamespace>Cronex.Hosting</RootNamespace>
    <AssemblyName>Cronex.Hosting</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cronex\Cronex.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exact lowest supported version, not a range. A floating range makes the published
         nuspec floor whatever happened to be latest at pack time, so consumers pinned below
         it break on restore without any source change to point at. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
