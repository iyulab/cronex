<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are stand-alone executables (BD-20260829-xunit-v3-pilot) -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cronex\Cronex.csproj" />
    <ProjectReference Include="..\..\src\Cronex.Hosting\Cronex.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit v3 pilot migration: xunit replaced with xunit.v3, no Microsoft.NET.Test.Sdk (not
         required under Microsoft.Testing.Platform, per xunit/samples.xunit v3/AssertExamples.csproj).
         xunit.runner.visualstudio kept for IDE Test Explorer discovery. -->
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- MTP equivalent of the ecosystem's VSTest blame-hang convention (BD-20260828-07) -->
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.3.3" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <!-- Deliberately the floor declared by Cronex.Net.Hosting, so the test run proves that
         floor actually builds and passes instead of only asserting it in the nuspec. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

</Project>
